import re

# Dữ liệu giả lập cơ sở dữ liệu người dùng trong hệ thống quản lý lớp học
DATABASE_USERS = {
    "admin_ttr": {
        "password": "Password123@", 
        "status": "active"
    },
    "gia_su_a": {
        "password": "SecurePassword1!", 
        "status": "locked" # Giả lập tài khoản bị khóa do nhập sai nhiều lần
    }
}

def validate_login_input(username, password):
    # Lỗi 1: Để trống thông tin
    if not username or not password:
        raise ValueError("Tên đăng nhập và mật khẩu không được để trống.")
    
    # Lỗi 2: Định dạng tên đăng nhập không hợp lệ 
    if not re.match("^[a-zA-Z0-9_]+$", username):
        raise ValueError("Tên đăng nhập chỉ được chứa chữ cái, số và dấu gạch dưới.")
        
    # Lỗi 3: Mật khẩu quá yếu / không đủ độ dài tối thiểu
    if len(password) < 6:
        raise ValueError("Mật khẩu phải có ít nhất 6 ký tự.")

def login_system(username, password):
    try:
        # Bước 1: Kiểm tra lỗi dữ liệu đầu vào
        validate_login_input(username, password)
        
        # Bước 2: Kiểm tra sự tồn tại của tài khoản trong hệ thống
        if username not in DATABASE_USERS:
            raise LookupError("Tên đăng nhập không tồn tại trong hệ thống quản lý lớp học.")
            
        user_data = DATABASE_USERS[username]
        
        # Bước 3: Kiểm tra trạng thái tài khoản (Lỗi tài khoản bị khóa)
        if user_data["status"] != "active":
            raise PermissionError("Tài khoản của bạn hiện đang bị khóa hoặc chưa được kích hoạt. Vui lòng liên hệ quản trị viên.")
            
        # Bước 4: Kiểm tra mật khẩu (Lỗi sai mật khẩu)
        if user_data["password"] != password:
            raise ConnectionRefusedError("Mật khẩu không chính xác. Vui lòng kiểm tra lại.")
            
        # Đăng nhập thành công
        print(f"Đăng nhập thành công! Chào mừng bạn quay lại hệ thống quản lý lớp học, {username}.")
        return True

    # Khối bắt lỗi và xử lý tương ứng để hiển thị thông báo thân thiện cho người dùng
    except ValueError as ve:
        print(f"[Lỗi dữ liệu đầu vào]: {ve}")
    except LookupError as le:
        print(f"[Lỗi tài khoản]: {le}")
    except PermissionError as pe:
        print(f"[Lỗi quyền truy cập]: {pe}")
    except ConnectionRefusedError as ce:
        print(f"[Lỗi xác thực]: {ce}")
    except Exception as e:
        print(f"[Lỗi hệ thống không xác định]: {e}")
    
    return False

# --- Kiểm thử các trường hợp lỗi có thể xảy ra ---
print("--- Trường hợp 1: Để trống thông tin ---")
login_system("", "")

print("\n--- Trường hợp 2: Sai mật khẩu ---")
login_system("admin_ttr", "WrongPassword")

print("\n--- Trường hợp 3: Tài khoản bị khóa ---")
login_system("gia_su_a", "SecurePassword1!")

print("\n--- Trường hợp 4: Đăng nhập thành công ---")
login_system("admin_ttr", "Password123@")